# =================================================================
# CONFIGURACIÓN DEL BACKEND PRODI
# =================================================================
# Copia este archivo como `.env` y completa los datos PENDIENTES.

# Puerto del servidor Express
PORT=4000

# =================================================================
# CONEXIÓN A MONGODB  *** PENDIENTE DE COMPLETAR ***
# =================================================================
MONGO_HOST=        # ej. localhost  ó  cluster0.abcde.mongodb.net
MONGO_PORT=27017
MONGO_USER=prodi        # usuario con permisos sobre la BD
MONGO_PASS=pr0d12026        # contraseña del usuario
MONGO_DB=ProdiPortal

# Alternativa: pasar URI completa (Atlas)
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/prodi?retryWrites=true&w=majority

# =================================================================
# JWT (autenticación)
# =================================================================
# CAMBIA este secreto por una cadena larga y aleatoria en producción.
JWT_SECRET=CAMBIAME-cadena-larga-aleatoria-en-produccion
JWT_EXPIRES=1d

